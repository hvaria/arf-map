# ── Application ────────────────────────────────────────────────────────────────
# Node environment. Set to "production" on your server.
NODE_ENV=development

# Express listen port (Render / Railway / Fly.io set this automatically).
PORT=5000

# ── Session security ────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
# REQUIRED in production — the default value is insecure.
SESSION_SECRET=change-me-use-openssl-rand-hex-32

# ── Database ────────────────────────────────────────────────────────────────────
# Absolute or relative path to the directory where data.db is stored.
# In Docker / Render, point this to a persistent disk mount (e.g. /data).
# Omit to store data.db in the project root (fine for local development).
# DATA_DIR=/data

# ── Email (SMTP) ────────────────────────────────────────────────────────────────
# Used for OTP email verification on registration.
# Leave blank in development — OTPs will be logged to the console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=ARF Care Portal <your-email@gmail.com>

# ── Mobile / PWA (optional) ─────────────────────────────────────────────────────
# Set to the server's public URL when building Capacitor native apps.
# Leave blank for standard web deployments.
# VITE_API_URL=https://your-domain.com

# ── Notes module beta ────────────────────────────────────────────────────────
# Comma-separated facility numbers allowed to see the dedicated /facility-portal/notes
# page. super_admin role bypasses this. Leave blank to keep OFF (default).
VITE_NOTES_DEDICATED_PAGE_FACILITIES=

# ── Operations paywall (Stripe — Phase 1) ────────────────────────────────────
# REQUIRED for billing — without these, POST /api/billing/checkout returns 503
# and the server otherwise boots normally. Operations stays gated behind the
# paywall in either case (see requireActiveSubscription middleware).
#
# Test mode keys for local dev, live keys for prod. Get from
# https://dashboard.stripe.com/apikeys.
STRIPE_SECRET_KEY=sk_test_...test

# Webhook signing secret. In local dev, run:
#   stripe listen --forward-to localhost:5000/api/billing/webhook
# and paste the printed `whsec_...` value here. In prod, copy from the
# webhook endpoint config in Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Price ID for the "Operations Pro Monthly" plan ($99/month) created
# in the Stripe Dashboard. Format: price_xxx.
STRIPE_PRICE_ID_OPS_PRO_MONTHLY=price_xxx

# Redirect URLs after Checkout completes / is cancelled. Hash-routed so
# they work in both web and Capacitor builds.
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5000/#/facility-portal?billing=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5000/#/facility-portal?billing=cancelled

# Return URL after the user closes the Stripe Customer Portal.
STRIPE_PORTAL_RETURN_URL=http://localhost:5000/#/facility-portal

# ── Operations paywall: in-app bypass codes (owner comps) ────────────────────
# Comma-separated list of codes that, when redeemed at the paywall, flip the
# authenticated facility account to `active` WITHOUT going through Stripe — no
# customer record, no subscription, no invoice, no webhook traffic. Used to comp
# the owner, internal testers, partners, and stakeholders.
#
# Codes are case-sensitive. Whitespace is trimmed. Empty entries are ignored.
# Leave blank to disable the feature entirely (the endpoint returns 503
# BYPASS_NOT_CONFIGURED and the "Have a promo code?" UI 503s on submit).
# Rotate by changing the env var and redeploying.
#
# Example: OPERATIONS_BYPASS_CODES=OWNER_FOREVER,STAFF_2026,PARTNER_DEMO
OPERATIONS_BYPASS_CODES=
