<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!-- Launch theme — Android 12+ uses Theme.SplashScreen's APIs
         (windowSplashScreenBackground + windowSplashScreenAnimatedIcon),
         older versions fall back to android:windowBackground. We
         suppress BOTH paths so no native splash icon ever renders:
         cream background, transparent icon. The brand-mark animation
         is owned end-to-end by the React BrandSplash component
         (client/src/components/BrandSplash.tsx). postSplashScreenTheme
         hands off to the regular AppTheme.NoActionBar once the splash
         API releases the window. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Android 12+ SplashScreen API. The icon is a vector painted
             in the same cream color as the background so it renders
             but is visually invisible — passing a transparent or
             missing drawable causes the OS to fall back to the
             launcher icon, which would show the brand mark cropped. -->
        <item name="windowSplashScreenBackground">#FFF8F1</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="windowSplashScreenIconBackgroundColor">#FFF8F1</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- Pre-Android-12 legacy fallback (android:windowBackground
             via android:background on Theme.SplashScreen ancestors). -->
        <item name="android:background">#FFF8F1</item>
        <item name="android:windowBackground">#FFF8F1</item>
    </style>
</resources>