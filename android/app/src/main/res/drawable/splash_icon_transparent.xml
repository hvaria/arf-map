<?xml version="1.0" encoding="utf-8"?>
<!--
  Cream-colored vector used as windowSplashScreenAnimatedIcon. Android
  12+ requires SOMETHING to be configured as the splash icon — if you
  set it to a transparent or invalid drawable, the OS silently falls
  back to the launcher icon and renders the brand mark cropped to the
  splash mask's safe area. Painting the icon in the same cream color
  as windowSplashScreenBackground (#FFF8F1) means the icon DOES render
  but is visually indistinguishable from the background, so the user
  sees a clean cream canvas until the React BrandSplash takes over.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFF8F1"
        android:pathData="M0,0L108,0L108,108L0,108Z" />
</vector>
